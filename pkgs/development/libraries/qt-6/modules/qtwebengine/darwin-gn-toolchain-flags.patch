@@ -210,6 +210,29 @@ declare_args() {
   # but ultimately the goal is for it to eventually be removed, once this mode
   # is stable enough.
   is_wexit_time_destructors_default = false
+
+  # Directory containing ld64.lld, used to make the unwrapped Clang driven by GN
+  # link with LLVM lld instead of Apple's cctools ld64, which SIGTRAPs on some of
+  # Chromium's large Mach-O links. Empty means use the toolchain's default ld.
+  qtwebengine_lld_path = ""
+
+  # Extra libc++ paths for downstream builds where the macOS toolchain invokes a
+  # Clang binary that does not know about the C++ standard library by itself.
+  # Nixpkgs uses this because Chromium's clang_base_path points at unwrapped clang.
+  qtwebengine_libcxx_include_dir = ""
+  qtwebengine_libcxx_library_dir = ""
+
+  # Extra libresolv paths for downstream builds whose SDK omits resolv.h and
+  # libresolv (e.g. Nixpkgs' Apple SDK ships them in a separate package). Passed
+  # as -isystem so third-party header diagnostics stay suppressed.
+  qtwebengine_libresolv_include_dir = ""
+  qtwebengine_libresolv_library_dir = ""
+
+  # Extra compiler-rt builtins directory for downstream builds where the macOS
+  # toolchain invokes an unwrapped Clang that does not auto-link
+  # libclang_rt.osx.a. Nixpkgs normally supplies this via the cc wrapper's
+  # -resource-dir, which Chromium's clang_base_path bypasses.
+  qtwebengine_compiler_rt_library_dir = ""
 }
 
