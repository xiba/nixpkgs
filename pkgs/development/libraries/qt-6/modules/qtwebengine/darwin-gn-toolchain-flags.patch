+    }
+
+    # Link with LLVM lld instead of Apple's cctools ld64, which SIGTRAPs on some
+    # of Chromium's large Mach-O links (e.g. v8_context_snapshot_generator). This
+    # is applied as an explicit "-fuse-ld=lld" rather than GN's use_lld=true so
+    # the archiver stays Apple libtool and we avoid needing the full LLVM
+    # binutils suite (llvm-ar/nm/otool) beside the unwrapped clang. "-B" points
+    # that clang at ld64.lld.
+    if (qtwebengine_lld_path != "") {
+      ldflags += [
+        "-fuse-ld=lld",
+        "-B" + qtwebengine_lld_path,
+      ]
+    }
+  }
