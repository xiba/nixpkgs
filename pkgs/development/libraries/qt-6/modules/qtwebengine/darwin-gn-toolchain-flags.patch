+    if (qtwebengine_libresolv_library_dir != "") {
+      ldflags += [
+        "-L" + qtwebengine_libresolv_library_dir,
+      ]
+    }
+
+    # Link compiler-rt builtins explicitly: the unwrapped Clang used by GN does
+    # not auto-link them, so Dawn's Metal backend and Blink otherwise fail with
+    # undefined ___divdc3 / ___isPlatformVersionAtLeast at the final link.
+    if (qtwebengine_compiler_rt_library_dir != "") {
+      ldflags += [
+        "-L" + qtwebengine_compiler_rt_library_dir,
+        "-lclang_rt.osx",
